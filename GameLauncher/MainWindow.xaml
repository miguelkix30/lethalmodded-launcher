<Window x:Class="GameLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:GameLauncher"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        ContentRendered="Window_ContentRendered"
        Title="REPO Modded Launcher | MiguelkiNetwork" Height="576" Width="1080" ResizeMode="CanMinimize">
    <Grid HorizontalAlignment="Center" VerticalAlignment="Center">
        <Image Stretch="UniformToFill" Source="images/LauncherBackground.png" Grid.ColumnSpan="5"/>
        <TextBlock Name="VersionText" VerticalAlignment="Bottom" HorizontalAlignment="Right" FontSize="20" Foreground="White" Margin="0, 0, 5, 0" Grid.Column="4" Height="27" Width="0"/>
        <Button Name="PlayButton" Content="Cargando..." Click="PlayButton_Click" Height="61" FontSize="28"  BorderThickness="5.0" Foreground="#DDFFFFFF" Margin="0,430,0,0" VerticalAlignment="Top" HorizontalAlignment="Center" MinWidth="150" Padding="10,1,10,1" Background="#FF0061FF" FontFamily="Bahnschrift" BorderBrush="#FF042761">
            <Button.Resources>
                <Style TargetType="Border">
                    <Setter Property="CornerRadius" Value="10"/>
                </Style>
            </Button.Resources>

        </Button>
        <Image Height="372" VerticalAlignment="Top" Source="/repologo.png" Width="436" HorizontalAlignment="Center" Margin="0,44,0,0"/>
        <Image x:Name="logo" HorizontalAlignment="Left" Height="140" Margin="39,31,0,0" VerticalAlignment="Top" Width="169" Source="/images/RepoIcon.png"/>
        <ProgressBar x:Name="progressbar"
             Height="14"
             VerticalAlignment="Bottom"
             RenderTransformOrigin="0.5,2.717"
             Foreground="#FF0061FF"
             BorderBrush="White" Background="White" Visibility="Collapsed" Grid.ColumnSpan="5"/>

    </Grid>
</Window>
